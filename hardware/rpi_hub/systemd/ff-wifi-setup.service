[Unit]
Description=Flash Flood hub: WiFi setup portal at boot (only if no saved WiFi joins within 60 s)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/pi/ff-hub/ff_wifi_portal.py boot
Restart=no

[Install]
WantedBy=multi-user.target
