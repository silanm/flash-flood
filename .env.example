# Copy to .env and fill in. Never commit .env.
NODERED_URL=http://HOST:1880
NODERED_USER=
NODERED_PASS=
INFLUX_URL=http://HOST:8086
INFLUX_USER=
INFLUX_PASS=
INFLUX_ORG=
INFLUX_BUCKET=flood
GRAFANA_URL=http://HOST:3000
GRAFANA_USER=
GRAFANA_PASS=
# Seen FROM the Node-RED / Grafana host (defaults suit a single box running everything)
NR_MQTT_HOST=127.0.0.1
NR_INFLUX_URL=http://127.0.0.1:8086
GRAFANA_INFLUX_URL=http://127.0.0.1:8086
# MQTT broker as seen by devices, and per-user passwords (scripts/mosquitto-auth.sh creates the users)
MQTT_HOST=HOST
MQTT_PORT=1883
MQTT_PW_nodered=
MQTT_PW_sim01=
MQTT_PW_node01=
MQTT_PW_hub=
# Optional: enables the REST endpoints (GET /api/v1/alerts, POST /api/v1/sites/<site>/ack). Without a password they are not deployed.
REST_USER=operator
REST_PASSWORD=
