  "tank": { "sensor_height_cm": 30, "valid_min_cm": 2, "valid_max_cm": 400 },
  "levels": { "warning_cm": 14, "critical_cm": 21 },
  "rates": { "warning_cm_min": 1.0, "critical_cm_min": 2.5 },
  "alerts": {
    "confirm_n": 3,
    "clear_hold_s": 30,
    "hysteresis_cm": 1,
    "hysteresis_cm_min": 0.3,
    "stale_after_s": 90,
    "sensor_clear_s": 30,
    "remind_min": 10,
    "dedupe_window_s": 60,
    "fallback": { "grace_s": 30, "pi_dead_after_s": 90, "cover_s": 120 }
  },
  "temperature": { "enabled": true, "assumed_sound_mps": 343, "valid_min_c": -10, "valid_max_c": 60, "hold_s": 300 },
  "filter": {
    "median_n": 5,
    "hampel_k": 3,
    "min_step_cm": 1,
    "max_rate_cm_min": 30,
    "confirm_n": 3,
    "stuck_n": 30,
    "rate_window_s": 90,
    "rate_min_span_s": 45,
    "ts_skew_s": 300,
    "invalid_suspect": 0.25,
    "invalid_bad": 0.5
  },
  "hub": { "default_mode": "edge", "state_refresh_s": 10, "heartbeat_s": 30 },
  "sim": { "node": "sim01", "autostart": true, "scenario": "calm", "seed": 1, "interval_s": 2 }
}
